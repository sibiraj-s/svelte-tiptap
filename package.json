{
  "name": "svelte-tiptap",
  "description": "Svelte components for tiptap v2",
  "version": "3.0.2",
  "author": "sibiraj-s",
  "license": "MIT",
  "repository": "github:sibiraj-s/svelte-tiptap",
  "bugs": "https://github.com/sibiraj-s/svelte-tiptap/issues",
  "homepage": "https://github.com/sibiraj-s/svelte-tiptap#readme",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/sibiraj-s"
    }
  ],
  "keywords": [
    "svelte",
    "tiptap",
    "svelte-tiptap",
    "tiptap-v2",
    "prosemirror",
    "rich-text-editor"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite dev --port 3009",
    "build:demo": "vite build",
    "build": "npm run build:demo && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "is-ci || npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "e2e": "cypress open --e2e",
    "lint": "eslint .",
    "prepare": "svelte-kit sync && (is-ci || husky)",
    "publish:npm": "npm publish"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-bubble-menu": "^3.0.0",
    "@tiptap/extension-floating-menu": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@floating-ui/dom": "^1.8.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",
    "@tiptap/extension-floating-menu": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^24.19.1",
    "clsx": "^2.1.1",
    "commitlint-config-non-conventional": "^1.0.1",
    "cypress": "^16.1.1",
    "eslint": "^10.11.0",
    "eslint-config-pegasus": "^6.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-svelte": "^3.23.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "sass": "^1.105.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-transform-extensions": "^1.0.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
